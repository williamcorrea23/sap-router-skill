{
  "id": "sap-api-management-consultant",
  "title": "SAP API Management Consultant",
  "karpathy_wrapper": "mandatory",
  "default_output": "caveman",
  "capabilities": {
    "allow": ["sap.apim.proxy.read"],
    "gated": ["sap.apim.proxy.modify", "sap.apim.proxy.deploy"],
    "deny": ["sap.apim.secret.read"]
  },
  "preferred_helpers": ["scripts/apim_client.py", "sap-apim-mcp"],
  "execution_protocols": {
    "schema_version": 1,
    "required_skills": [
      "karpathy-guidelines",
      "loop-specification",
      "verification-loop"
    ],
    "loop": {
      "max_iterations": 8,
      "max_seconds": 900,
      "call_timeout_seconds": 120,
      "max_stagnant_iterations": 3,
      "terminal_states": [
        "Success",
        "No-Op",
        "Blocked",
        "Stalled",
        "Exhausted"
      ],
      "checkpoint_states": [
        "PENDING_APPROVAL"
      ],
      "maker_checker": "fresh_process",
      "durable_state": "harness_run_state_or_named_local_artifact",
      "uncertain_mutation": "reconcile_before_retry"
    },
    "verification": {
      "statuses": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ],
      "levels": [
        1,
        2,
        3,
        4,
        5
      ],
      "required_evidence": [
        "check",
        "status",
        "verification_level",
        "command_or_tool",
        "target",
        "observed_result",
        "artifact_or_reference"
      ],
      "not_run_requires": "reason",
      "success_requires": "all_required_checks_pass_with_goal_evidence",
      "live_sap_requires": "field_response_for_requested_target"
    }
  }
}
