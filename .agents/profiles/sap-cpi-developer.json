{
  "id": "sap-cpi-developer",
  "title": "Senior SAP Cloud Integration Developer",
  "karpathy_wrapper": "mandatory",
  "default_output": "caveman",
  "capabilities": {
    "allow": [
      "sap.cpi.package.read",
      "sap.cpi.artifact.read",
      "sap.cpi.runtime.read",
      "sap.cpi.message.read",
      "sap.cpi.message.detail.read",
      "sap.cpi.trace.read",
      "sap.cpi.quality.check",
      "sap.cpi.query.read",
      "sap.cpi.mapping.test"
    ],
    "gated": [
      "sap.cpi.artifact.deploy",
      "sap.cpi.artifact.undeploy",
      "sap.cpi.iflow.generate",
      "sap.cpi.diagram.generate",
      "sap.cpi.sync.execute"
    ],
    "deny": ["sap.cpi.security.secret.read"]
  },
  "preferred_helpers": ["scripts/cpi_client.py", "sap-cpi-mcp"]
}
