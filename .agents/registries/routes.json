    {"match": ["mpl", "message processing log"], "capability": "sap.cpi.message.read", "profile": "sap-cpi-developer", "fallback_group": "cpi"},
    {"match": ["cpi", "iflow", "integration flow"], "capability": "sap.cpi.artifact.read", "profile": "sap-cpi-developer", "fallback_group": "cpi"},
