    ,{"match": ["successfactors", "employee central", "sfapi", "employee data"], "capability": "sap.successfactors.data.read", "profile": "sap-hcm-consultant", "fallback_group": "successfactors"}
    ,{"match": ["basis", "kernel", "saprouter", "housekeeping", "health triage"], "capability": "sap.documentation.search", "profile": "sap-basis-consultant", "fallback_group": "basis"}
